# SUSTITUIR por el dominio real antes de desplegar. Con el placeholder,
# el ACME de Caddy para HTTPS automático fallará: no controlas ese dominio.
totem.sunube.net {
    encode gzip

    # WebSocket del broker MQTT.
    handle /mqtt* {
        reverse_proxy mosquitto:9001
    }

    # external_api.js autoalojado: el arranque del totem no debe depender
    # de que responda el dominio del proveedor de Jitsi.
    handle /vendor/* {
        root * /srv
        file_server
    }

    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
